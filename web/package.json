{
  "name": "cypress-creek-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Cypress Creek browser UI: a thin Svelte front end for the local API",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "check-dist": "node scripts/check-dist.mjs",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run check-dist"
  },
  "dependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
